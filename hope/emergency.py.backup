
"""HOPE Emergency Case Details."""

from workpeg.ui import (
    App, State, Padding, Column, Row, Container, Spacer,
    Text, Button, Select, Divider, Link, ListView,
    biz_url, route, navigate, set_title, store, toast, workpeg,
)

from components import ErrorState, LoadingState

TABLE_NAMESPACE = "emergencies"


class EmergencyCasePage(App):
    table = State("")
    emergency_id = State(0)
    row = State({})
    loading = State(True)
    error = State("")
    status = State("received")
    saving = State(False)

    async def on_mount(self):
        store.page_title = "Emergency Case"
        self.loading = True
        self.error = ""

        try:
            self.emergency_id = int(route.emergency_id)
            tables = await workpeg.get_tables(TABLE_NAMESPACE)

            if len(tables) == 0:
                self.error = "Emergency register not found."
            else:
                self.table = tables[0]["uuid"]
                record = await workpeg.get_row(
                    self.table,
                    self.emergency_id,
                )

                if not record:
                    self.error = (
                        "No emergency case was found for case ID "
                        + str(self.emergency_id)
                        + "."
                    )
                elif "data" not in record:
                    self.error = "The emergency record has no data field."
                else:
                    self.show(record)

        except Exception as e:
            self.error = str(e)

        self.loading = False

    def show(self, row):
        self.row = row
        self.status = row["data"].get("status", "received")
        set_title("Emergency case " + str(self.emergency_id))

    def set_status(self, value):
        self.status = value

    async def save(self):
        if self.saving or not self.row:
            return

        self.saving = True
        before = self.row
        data = {}

        for key in self.row["data"]:
            data[key] = self.row["data"][key]

        data["status"] = self.status

        try:
            updated = await workpeg.update_row(
                self.table,
                self.emergency_id,
                {"data": data},
            )
            self.show(updated)
            toast("Emergency status updated", kind="success")

        except Exception as e:
            self.show(before)
            toast(str(e), kind="danger")

        self.saving = False

    def back(self):
        navigate(biz_url("/dispatch"))

    def save_button(self):
        if self.saving:
            return Button("Saving...", disabled=True)

        return Button(
            "Update case status",
            on_click=self.save,
        )

    def details(self):
        return Container(
            Column(
                Text("Emergency information", weight="semibold"),
                Divider(),
                Text("Guest / Patient", variant="muted"),
                Text(str(self.row["data"].get("guest_name", "Not provided"))),
                Divider(),
                Text("Contact phone", variant="muted"),
                Text(str(self.row["data"].get("phone", "Not provided"))),
                Divider(),
                Text("Emergency type", variant="muted"),
                Text(str(self.row["data"].get("emergency_type", "Not provided"))),
                Divider(),
                Text("Incident location", variant="muted"),
                Text(str(self.row["data"].get("location", "Not provided"))),
                Divider(),
                Text("Priority", variant="muted"),
                Text(str(self.row["data"].get("priority", "Not provided"))),
                Divider(),
                Text("Additional information", variant="muted"),
                Text(str(self.row["data"].get("notes", "None provided"))),
                gap=12,
            ),
            variant="card",
            padding=24,
        )

    def status_panel(self):
        return Container(
            Column(
                Text("Response management", weight="semibold"),
                Text(
                    "Update the current stage of this emergency response.",
                    variant="muted",
                ),
                Select(
                    options=[
                        {"value": "received", "label": "Received"},
                        {"value": "assigned", "label": "Assigned"},
                        {"value": "responding", "label": "Responding"},
                        {"value": "arrived", "label": "Arrived"},
                        {"value": "completed", "label": "Completed"},
                    ],
                    value=self.status,
                    on_change=self.set_status,
                    label="Emergency status",
                ),
                Row(Spacer(), self.save_button()),
                gap=16,
            ),
            variant="card",
            padding=24,
        )

    def build(self):
        if self.loading:
            return LoadingState("Loading emergency case...")

        elif self.error != "":
            return Padding(
                ErrorState(
                    self.error,
                    Button(
                        "Back to dispatch",
                        variant="outline-gray",
                        icon="arrow-left",
                        on_click=self.back,
                    ),
                ),
                all=24,
            )

        elif not self.row:
            return Padding(
                ErrorState(
                    "The emergency record is empty.",
                    Button(
                        "Back to dispatch",
                        variant="outline-gray",
                        on_click=self.back,
                    ),
                ),
                all=24,
            )

        else:
            return ListView(
                Link(
                    "Emergency Dispatch",
                    href=biz_url("/dispatch"),
                    icon="arrow-left",
                ),
                Row(
                    Column(
                        Text("Emergency Case", variant="heading"),
                        Text(
                            "Case ID: " + str(self.emergency_id),
                            variant="muted",
                        ),
                        gap=4,
                    ),
                    Spacer(),
                    Button(
                        "Back to list",
                        variant="outline-gray",
                        on_click=self.back,
                    ),
                    align="center",
                ),
                self.details(),
                self.status_panel(),
                height="100%",
                padding=24,
                gap=24,
            )
